# Общие
SPARK_NO_DAEMONIZE=true
PYTHONUNBUFFERED=1

# --- Airflow secrets (сгенерируй и положи в .env) ---
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# Postgres (внутри docker-сети)
PGHOST=postgres
PGPORT=5432
PGDATABASE=dwh
PGUSER=app
PGPASSWORD=app

# MinIO (S3 endpoint внутри docker-сети)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=airflow
MINIO_SECRET_KEY=airflow123
MINIO_BUCKET=warehouse

# Metabase / BI
METABASE_PORT=3000
MB_JAVA_TIMEZONE=Europe/Moscow
BI_PG_USER=bi_readonly
BI_PG_PASSWORD=bi_readonly_change_me

